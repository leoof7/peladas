# Dados de conexão com o Firebase.
# Copie este arquivo para ".env" e preencha com o bloco que o Firebase mostra
# em Configurações do projeto > Seus aplicativos > Web.
# Sem isso o app abre em MODO DE TESTE: os dados ficam só no próprio celular.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
